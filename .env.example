# Domain where HeyForm should be reachable (without https://)
DOMAIN=forms.yourdomain.com

# HeyForm secrets – generate each with `openssl rand -hex 32`
SESSION_KEY=
FORM_ENCRYPTION_KEY=

# SMTP – example values shown are for Resend; swap for your provider
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=HeyForm <noreply@yourdomain.com>
