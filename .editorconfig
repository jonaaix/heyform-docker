root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
max_line_length = 130
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.php]
max_line_length = 135

[*.blade.php]
max_line_length = 150

[*.{yml,yaml}]
indent_size = 4

[compose*.yml]
indent_size = 4
